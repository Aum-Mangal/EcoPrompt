{
  "manifest_version": 3,
  "name": "EcoPrompt — AI Environmental Impact Tracker",
  "version": "1.0.0",
  "description": "See the real environmental cost of every AI response — water, energy, and CO2 estimated in real time.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/gemini.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/worker.js"
  },
  "action": {
  "default_popup": "popup-src/dist/index.html",
  "default_title": "EcoPrompt"
}
}